# Copy to .env and fill in. Never commit .env.
# ---- Database ----
# Local dev (Docker Postgres from docker-compose.yml):
DATABASE_URL=postgresql+psycopg://backtestlab:backtestlab@localhost:5432/backtestlab
# Production (Supabase) will look like:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<project>.supabase.co:5432/postgres

# ---- App ----
APP_ENV=development
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS. In prod set this to the
# deployed frontend URL, e.g. https://backtestlab-web.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Phase 1: market data (Binance public REST — no key needed for klines) ----
BINANCE_BASE_URL=https://api.binance.com

# ---- Phase 3: auth (Supabase) ----
# Local dev works WITHOUT these: send  Authorization: Bearer dev:you@example.com
AUTH_DEV_MODE=true
FREE_MONTHLY_LIMIT=5

# ---- Abuse protection for the public POST /backtest ----
# Max backtest runs allowed per client IP within the rolling window (seconds).
# Protects a small instance's CPU; raise if you move to bigger hardware.
BACKTEST_RATE_LIMIT=20
BACKTEST_RATE_WINDOW=60
# Production: get this from Supabase > Project Settings > API > JWT Secret.
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUD=authenticated

# ---- Phase 5: billing (Lemon Squeezy — Merchant of Record) ----
# We use Lemon Squeezy instead of Stripe so we can launch without business
# verification and let the provider handle global sales tax/VAT. Billing is OFF
# until LEMONSQUEEZY_API_KEY, LEMONSQUEEZY_STORE_ID and LEMONSQUEEZY_VARIANT_PRO
# are set; while off, /billing/* actions return 503 and the frontend hides the
# upgrade UI. See docs/LEMONSQUEEZY_SETUP.md for the full walkthrough. To enable:
#   1. lemonsqueezy.com -> Settings > API -> create an API key.
#   2. Store id: Settings > Stores (or the URL /dashboard) -> the numeric id.
#   3. Create a Product with a recurring "Pro" variant -> copy the variant id.
#   4. Webhook secret: Settings > Webhooks -> add an endpoint at
#      <public-url>/billing/webhook, sign it with a secret, subscribe to the
#      subscription_* events, and paste that secret below.
# LEMONSQUEEZY_API_KEY=eyJ0eXAi...
# LEMONSQUEEZY_STORE_ID=12345
# LEMONSQUEEZY_VARIANT_PRO=67890
# LEMONSQUEEZY_WEBHOOK_SECRET=your-signing-secret
# Where Checkout/Portal redirect back to (the frontend origin):
# FRONTEND_URL=http://localhost:5173
