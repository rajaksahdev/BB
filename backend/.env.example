# Copy to .env and fill in. Never commit .env.
# ---- Database ----
# Local dev (Docker Postgres from docker-compose.yml):
DATABASE_URL=postgresql+psycopg://backtestlab:backtestlab@localhost:5432/backtestlab
# Production (Supabase) will look like:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<project>.supabase.co:5432/postgres

# ---- App ----
APP_ENV=development
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS. In prod set this to the
# deployed frontend URL, e.g. https://backtestlab-web.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Phase 1: market data (Binance public REST — no key needed for klines) ----
BINANCE_BASE_URL=https://api.binance.com

# ---- Phase 3: auth (Supabase) ----
# Local dev works WITHOUT these: send  Authorization: Bearer dev:you@example.com
AUTH_DEV_MODE=true
FREE_MONTHLY_LIMIT=5

# ---- Abuse protection for the public POST /backtest ----
# Max backtest runs allowed per client IP within the rolling window (seconds).
# Protects a small instance's CPU; raise if you move to bigger hardware.
BACKTEST_RATE_LIMIT=20
BACKTEST_RATE_WINDOW=60
# Production: get this from Supabase > Project Settings > API > JWT Secret.
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUD=authenticated

# ---- Phase 5: billing (Stripe) ----
# Billing is OFF until STRIPE_SECRET_KEY and STRIPE_PRICE_PRO are set; while off,
# /billing/* actions return 503 and the frontend hides upgrade UI. To enable:
#   1. Stripe Dashboard (test mode) > Developers > API keys -> copy the secret key.
#   2. Create a recurring Product/Price for "Pro" -> copy the Price ID (price_...).
#   3. Webhook secret: run `stripe listen --forward-to localhost:8000/billing/webhook`
#      (Stripe CLI) and copy the printed whsec_..., OR create a webhook endpoint in
#      the Dashboard pointing at <public-url>/billing/webhook. Subscribe to:
#      checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where Checkout/Portal redirect back to (the frontend origin):
# FRONTEND_URL=http://localhost:5173
